{
  "name": "pixel-cli",
  "version": "0.1.0",
  "description": "CLI to optimize image folders — format-preserving, structure-preserving, safe by default",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Leano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leanojs/pixel.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/leanojs/pixel#readme",
  "bugs": {
    "url": "https://github.com/leanojs/pixel/issues"
  },
  "keywords": [
    "cli",
    "image",
    "optimize",
    "compress",
    "png",
    "jpeg",
    "webp",
    "pixel"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "pixel": "./dist/index.js"
  },
  "files": ["dist/index.js"],
  "scripts": {
    "build": "rm -rf dist && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "lint": "eslint src/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@pixel/core": "workspace:*",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
